# Session signing key — use a long random string in production
SESSION_SECRET=change-me-to-a-64-character-random-string

# Seeded administrator (created on first database boot)
ADMIN_EMAIL=admin@anerith.local
ADMIN_PASSWORD=Admin!2345

# Optional: override database location
# DATABASE_PATH=./data/anerith.db

# Seed demo trader, demo accounts, demo brokers and a sample leaderboard.
# Defaults to true outside production and false in production. Never enable on a live site.
# SEED_DEMO_DATA=false

# Public base URL — used to build PesaPal callback and IPN URLs.
# Set this in production (e.g. https://anerith.com). Falls back to the request host.
# APP_URL=http://localhost:3000

# PesaPal v3 payment gateway
# 1. Create an account at https://pesapal.com and open the merchant dashboard
# 2. Copy the consumer key and secret for the environment you want to use
# 3. Sandbox: https://cybqa.pesapal.com/pesapalv3 · Live: https://pay.pesapal.com/v3
# Sandbox IPN/callback URLs must be publicly reachable (use a tunnel in local dev).
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CURRENCY=USD
# PESAPAL_DEFAULT_COUNTRY_CODE=KE
# PESAPAL_DEFAULT_PHONE=0700000000
# PESAPAL_IPN_METHOD=GET
# Optional: skip IPN auto-registration when the endpoint is already registered
# PESAPAL_IPN_ID=
# Optional: override the IPN URL registered with PesaPal
# PESAPAL_IPN_URL=https://anerith.com/api/payments/pesapal/ipn
# Optional: override the API base (used for mock gateways in tests)
# PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3

# Supabase mirror (optional)
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Copy the project URL and service-role key here, then restart the app
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# External live market data (optional — server-side only, never exposed to the browser)
# Only enable after confirming your provider licence permits the use you intend.
# 1. Set LIVE_RATES_URL to the provider's JSON quote endpoint
# 2. Set LIVE_RATES_API_KEY (and header/prefix if the provider differs from Bearer-style auth)
# 3. In Admin → Trading engine, switch Market data provider to "live-rates"
# 4. Optionally set LIVE_RATES_CANDLES_URL with {symbol}, {interval} and {limit} placeholders
# 5. Map provider tickers with LIVE_RATES_SYMBOL_MAP, e.g. {"EURUSD":"EUR/USD","XAUUSD":"XAU/USD"}
# Quotes older than max_quote_age_ms are rejected and trading pauses until fresh data arrives.
# LIVE_RATES_URL=https://provider.example.com/v1/quotes
# LIVE_RATES_API_KEY=
# LIVE_RATES_KEY_HEADER=Authorization
# LIVE_RATES_KEY_PREFIX=Bearer
# LIVE_RATES_SYMBOL_MAP={"EURUSD":"EUR/USD"}
# LIVE_RATES_INTERVAL_MAP={"1m":"1min"}
# LIVE_RATES_CANDLES_URL=https://provider.example.com/v1/candles?symbol={symbol}&interval={interval}&limit={limit}
# LIVE_RATES_TIMEOUT_MS=5000

