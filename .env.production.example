# Copy to .env.production on the server. Never commit this file.
# Generate SESSION_SECRET with: openssl rand -hex 48

DOMAIN=anerith.example.com
APP_URL=https://anerith.example.com

SESSION_SECRET=replace-with-64-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Keep false on a live site. Demo accounts use known passwords.
SEED_DEMO_DATA=false

DATABASE_PATH=/data/anerith.db

PESAPAL_ENV=live
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CURRENCY=USD
PESAPAL_IPN_METHOD=GET
# PESAPAL_IPN_ID=

# Optional Supabase reporting mirror
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
